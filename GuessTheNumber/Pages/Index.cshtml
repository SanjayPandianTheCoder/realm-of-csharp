@page
@model IndexModel
@{
    ViewData["Title"] = "Guess The Number";

    var state = Model.currentState;
    var hasGame = state.randomNumber != 0;
    var won = state.isNumberGuessed;
    var hasGuesses = state.guessesList?.Any() == true;
}

<div class="min-h-[85vh] w-full flex items-center justify-center px-4 py-8 sm:px-6 lg:px-10 bg-gradient-to-br from-indigo-50 via-white to-violet-50">
    <div class="w-full max-w-6xl bg-white rounded-3xl shadow-2xl ring-1 ring-black/5 overflow-hidden">

        <div class="grid grid-cols-1 lg:grid-cols-5">

            @* ---------- LEFT PANEL: title + game info ---------- *@
            <div class="relative lg:col-span-2 bg-gradient-to-br from-indigo-600 to-violet-700 text-white p-8 sm:p-10 lg:p-12 flex flex-col justify-center gap-6 overflow-hidden">
                <span aria-hidden="true" class="pointer-events-none select-none absolute -right-6 -bottom-16 text-[14rem] sm:text-[18rem] font-black leading-none text-white/10">?</span>

                <h1 class="relative text-4xl sm:text-5xl lg:text-5xl xl:text-6xl font-extrabold leading-tight tracking-tight">
                    Guess The Number
                </h1>

                @if (hasGame && !won)
                {
                    <div class="relative space-y-3">
                        <p class="text-indigo-100 text-lg leading-relaxed">
                            Hi <span class="font-semibold text-white">@state.name</span>,
                            I'm thinking of a number between
                            <span class="font-semibold text-white">1</span> and
                            <span class="font-semibold text-white">@state.range</span>.
                        </p>
                        <span class="inline-block rounded-full bg-white/20 px-4 py-1 text-xs font-semibold uppercase tracking-wide text-white">
                            @state.difficulty
                        </span>
                    </div>
                }
            </div>

            @* ---------- RIGHT PANEL: result + forms ---------- *@
            <div class="lg:col-span-3 p-6 sm:p-10 lg:p-12 flex flex-col justify-center gap-8">

                @* ---------- SCREEN 3: WIN RESULT ---------- *@
                @if (won)
                {
                    <div class="rounded-2xl bg-green-50 border border-green-200 p-6 text-center space-y-2">
                        <p class="text-2xl sm:text-3xl font-bold text-green-700">🎉 Well done, @state.name!</p>
                        <p class="text-gray-700">
                            The number was <span class="font-bold">@state.randomNumber</span>.
                        </p>
                        <p class="text-gray-700">
                            Guesses: <span class="font-bold">@state.noOfGuesses</span>
                            &middot; Score: <span class="font-bold">@state.score</span>
                        </p>
                    </div>
                }

                @* ---------- SCREEN 1: START FORM ---------- *@
                @if (!hasGame || won)
                {
                    <form method="post" asp-page-handler="GameStart" class="space-y-6">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div>
                                <label for="game-name" class="block text-sm font-medium text-gray-700 mb-1.5">Enter your name</label>
                                <input type="text" asp-for="gameStart.name" id="game-name" required
                                       class="w-full rounded-xl border border-gray-300 bg-gray-50 px-4 py-3 text-base focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" />
                            </div>

                            <div>
                                <label for="game-difficulty" class="block text-sm font-medium text-gray-700 mb-1.5">Select difficulty</label>
                                <select asp-for="gameStart.difficulty" id="game-difficulty" required
                                        class="w-full rounded-xl border border-gray-300 bg-gray-50 px-4 py-3 text-base focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition">
                                    <option value="easy">Easy (1 - 50)</option>
                                    <option value="intermediate">Intermediate (1 - 100)</option>
                                    <option value="hard">Hard (1 - 500)</option>
                                </select>
                            </div>
                        </div>

                        <button type="submit"
                                class="w-full rounded-xl bg-indigo-600 py-3.5 text-lg font-semibold text-white shadow-lg shadow-indigo-600/25 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 active:scale-[0.99] transition">
                            @(won ? "Play Again" : "Start Game")
                        </button>
                    </form>
                }

                @* ---------- SCREEN 2: GUESSING ---------- *@
                @if (hasGame && !won)
                {
                    <form method="post" asp-page-handler="SubmitGuess" class="space-y-6">
                        <div>
                            <label for="game-guess" class="block text-sm font-medium text-gray-700 mb-1.5">Enter your guess</label>
                            <input id="game-guess" asp-for="Guess" type="number" min="1" max="@state.range" required
                                   class="w-full rounded-xl border-2 border-gray-300 bg-gray-50 px-4 py-4 text-center text-3xl sm:text-4xl font-bold text-indigo-700 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition" />
                        </div>
                        <button type="submit"
                                class="w-full rounded-xl bg-indigo-600 py-3.5 text-lg font-semibold text-white shadow-lg shadow-indigo-600/25 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 active:scale-[0.99] transition">
                            Guess
                        </button>
                    </form>
                }
            </div>
        </div>

        @* ---------- GUESS HISTORY (full-width strip) ---------- *@
        @if (hasGuesses)
        {
            <div class="border-t border-gray-200 bg-gray-50 px-6 py-6 sm:px-10 lg:px-12 flex flex-col gap-5 md:flex-row md:items-center md:gap-10">
                <div class="md:shrink-0">
                    @if (state.guessesList.Last() > state.randomNumber)
                    {
                        <p class="inline-block rounded-xl bg-rose-100 px-5 py-2 text-2xl font-extrabold tracking-wide text-rose-700">LOWER</p>
                    }
                    else
                    {
                        <p class="inline-block rounded-xl bg-amber-100 px-5 py-2 text-2xl font-extrabold tracking-wide text-amber-700">HIGHER</p>
                    }
                </div>

                <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-gray-700 mb-2">
                        Your guesses (@state.noOfGuesses)
                    </p>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var g in state.guessesList)
                        {
                            var correct = won && g == state.randomNumber;
                            <span class="rounded-full px-4 py-1.5 text-sm font-semibold @(correct ? "bg-green-100 text-green-700 ring-1 ring-green-300" : "bg-white text-gray-700 ring-1 ring-gray-200")">
                                @g
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script src="https://cdn.tailwindcss.com"></script>
